# --- X API (https://developer.x.com/en/portal/dashboard) ---

# App-only Bearer Token: 検索 / ユーザー取得 / タイムライン取得に使用
X_BEARER_TOKEN=

# OAuth 2.0 Client ID / Secret: 「Xでログイン」と投稿に使用
# Developer Portal > App > User authentication settings で
#   Type of App: Web App
#   Callback URI: https://<your-domain>/api/auth/callback
# を設定してください
X_CLIENT_ID=
X_CLIENT_SECRET=

# 任意: セッション Cookie 暗号化キー (未設定時は X_CLIENT_SECRET を使用)
SESSION_SECRET=

# 任意: 公開URL (未設定時はリクエストの Host から自動判定)
APP_URL=
